#
# Default server configuration
#
server {
        listen      80 default_server;
        listen [::]:80 default_server;
        root /var/www/html;
        index index.html index.htm index.nginx-debian.html;
        server_name _;

        location / {
                # forward all traffic to the installed kubernetes app
                proxy_pass  http://localhost:30000 ;
        }
}
